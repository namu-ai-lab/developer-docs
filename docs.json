{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Namu API",
  "description": "Speech recognition, speech synthesis, translation and a voice agent for Hausa, Zarma and French.",
  "favicon": "/assets/logos/namu-favicon.svg",
  "logo": {
    "light": "/assets/logos/namu-docs-logo-dark.svg",
    "dark": "/assets/logos/namu-docs-logo-light.svg",
    "href": "/"
  },
  "colors": {
    "primary": "#0D0D0D",
    "light": "#F5F5F5",
    "dark": "#0D0D0D"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0D0D0D"
    }
  },
  "fonts": {
    "family": "DM Sans"
  },
  "appearance": {
    "default": "light"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "banner": {
    "content": "The Namu API is in beta: every account gets **30 free minutes of audio a month**. [Get a key →](https://www.namuai-lab.com/account/keys)",
    "dismissible": true
  },
  "navbar": {
    "links": [
      {
        "label": "Namu AI Lab",
        "href": "https://www.namuai-lab.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "API dashboard",
      "href": "https://www.namuai-lab.com/account"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "api": {
    "openapi": "api-reference/openapi.yaml",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ],
      "defaults": "required"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "pricing-and-limits"
            ]
          },
          {
            "group": "SDKs and tools",
            "pages": [
              "sdks/overview",
              "sdks/python",
              "sdks/javascript",
              "sdks/http"
            ]
          },
          {
            "group": "Mobile apps",
            "pages": [
              "sdks/android",
              "sdks/ios"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "resources/changelog",
              "resources/support",
              "resources/responsible-use",
              "resources/glossary"
            ]
          }
        ]
      },
      {
        "tab": "Models",
        "groups": [
          {
            "group": "Models",
            "pages": [
              "models",
              "voices-and-languages"
            ]
          }
        ]
      },
      {
        "tab": "Text to speech",
        "groups": [
          {
            "group": "Text to speech",
            "pages": [
              "capabilities/text-to-speech",
              "guides/audio-formats"
            ]
          },
          {
            "group": "Build",
            "pages": [
              "tutorials/read-aloud-in-hausa",
              "tutorials/voice-messages-for-a-clinic"
            ]
          }
        ]
      },
      {
        "tab": "Speech to text",
        "groups": [
          {
            "group": "Speech to text",
            "pages": [
              "capabilities/speech-to-text"
            ]
          },
          {
            "group": "Build",
            "pages": [
              "tutorials/transcribe-a-voice-note"
            ]
          }
        ]
      },
      {
        "tab": "Translation",
        "groups": [
          {
            "group": "Translation",
            "pages": [
              "capabilities/translation"
            ]
          },
          {
            "group": "Build",
            "pages": [
              "tutorials/hausa-french-interpreter"
            ]
          }
        ]
      },
      {
        "tab": "Voice agent",
        "groups": [
          {
            "group": "Voice agent",
            "pages": [
              "capabilities/voice-agent"
            ]
          },
          {
            "group": "Build",
            "pages": [
              "tutorials/talk-to-the-voice-agent"
            ]
          }
        ]
      },
      {
        "tab": "Production",
        "groups": [
          {
            "group": "Production",
            "pages": [
              "guides/production-checklist",
              "guides/api-keys",
              "guides/errors",
              "guides/usage-and-rate-limits",
              "guides/weak-networks"
            ]
          },
          {
            "group": "Build",
            "pages": [
              "tutorials/first-call",
              "tutorials/watch-your-usage"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/errors"
            ]
          },
          {
            "group": "Speech",
            "openapi": "api-reference/openapi.yaml",
            "pages": [
              "POST /v1/speech"
            ]
          },
          {
            "group": "Transcription",
            "openapi": "api-reference/openapi.yaml",
            "pages": [
              "POST /v1/transcribe"
            ]
          },
          {
            "group": "Translation",
            "openapi": "api-reference/openapi.yaml",
            "pages": [
              "POST /v1/translate"
            ]
          },
          {
            "group": "Voice agent",
            "openapi": "api-reference/openapi.yaml",
            "pages": [
              "POST /v1/converse"
            ]
          },
          {
            "group": "Models and voices",
            "openapi": "api-reference/openapi.yaml",
            "pages": [
              "GET /v1/models",
              "GET /v1/voices"
            ]
          },
          {
            "group": "Account",
            "openapi": "api-reference/openapi.yaml",
            "pages": [
              "GET /v1/usage",
              "GET /v1/health"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://www.namuai-lab.com"
    },
    "links": [
      {
        "header": "Namu API",
        "items": [
          {
            "label": "Get an API key",
            "href": "https://www.namuai-lab.com/account/keys"
          },
          {
            "label": "Usage",
            "href": "https://www.namuai-lab.com/account/usage"
          },
          {
            "label": "Changelog",
            "href": "/resources/changelog"
          }
        ]
      },
      {
        "header": "Namu AI Lab",
        "items": [
          {
            "label": "Research",
            "href": "https://www.namuai-lab.com/research"
          },
          {
            "label": "Privacy",
            "href": "https://www.namuai-lab.com/privacy"
          },
          {
            "label": "Terms",
            "href": "https://www.namuai-lab.com/terms"
          }
        ]
      }
    ]
  },
  "seo": {
    "metatags": {
      "og:site_name": "Namu API"
    }
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "This page is not here",
      "description": "It may have moved. Start again from the [overview](/)."
    }
  }
}
