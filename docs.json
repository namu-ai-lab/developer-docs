{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Namu API",
  "description": "Speech recognition, speech synthesis, translation and a voice agent for Hausa, Zarma and French.",
  "favicon": "/assets/logos/namu-favicon.svg",
  "logo": {
    "light": "/assets/logos/namu-docs-logo-dark.svg",
    "dark": "/assets/logos/namu-docs-logo-light.svg",
    "href": "/"
  },
  "colors": {
    "primary": "#15120F",
    "light": "#E8A77B",
    "dark": "#15120F"
  },
  "background": {
    "color": {
      "light": "#FFFAF1",
      "dark": "#1C1410"
    }
  },
  "fonts": {
    "family": "DM Sans"
  },
  "appearance": {
    "default": "light"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "banner": {
    "content": "The Namu API is in beta: every account gets **30 free minutes of audio a month**. [Get a key →](https://www.namuai-lab.com/account/keys)",
    "dismissible": true
  },
  "navbar": {
    "links": [
      {
        "label": "Namu AI Lab",
        "href": "https://www.namuai-lab.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "API dashboard",
      "href": "https://www.namuai-lab.com/account"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ],
      "defaults": "required"
    }
  },
  "navigation": {
